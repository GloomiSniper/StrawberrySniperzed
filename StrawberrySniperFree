-- =====================
-- HELPERS
-- =====================
local function make(class, props, parent)
    local i = Instance.new(class)
    for k, v in pairs(props or {}) do
        i[k] = v
    end
    if parent then
        i.Parent = parent
    end
    return i
end

local function corner(parent, radius)
    make("UICorner", {CornerRadius = UDim.new(0, radius or 8)}, parent)
end

local function stroke(parent, color, thickness, transparency)
    return make("UIStroke", {
        Color = color or C.line,
        Thickness = thickness or 1,
        Transparency = transparency or 0,
    }, parent)
end

local function tween(obj, t, props, style)
    TweenService:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Quad), props):Play()
end

local function gradient(parent, c1, c2, rotation)
    make("UIGradient", {
        Color = ColorSequence.new(c1, c2),
        Rotation = rotation or 90,
    }, parent)
end

local function label(text, size, color, font, align, parent)
    local l = make("TextLabel", {
        BackgroundTransparency = 1,
        Text = text,
        Font = font or gothamMed,
        TextSize = size or 12,
        TextColor3 = color or C.txt,
        TextXAlignment = align or Enum.TextXAlignment.Left,
    }, parent)
    return l
end

local function plainBtn(text, parent)
    local b = make("TextButton", {
        BackgroundColor3 = C.panel2,
        Text = text,
        Font = gothamBold,
        TextSize = 12,
        TextColor3 = C.txt,
        AutoButtonColor = false,
        BorderSizePixel = 0,
    }, parent)
    corner(b, 8)
    local s = stroke(b, C.line, 1, 0.2)
    b.MouseEnter:Connect(function()
        tween(b, 0.12, {BackgroundColor3 = C.panel})
        tween(s, 0.12, {Color = C.acc, Transparency = 0})
    end)
    b.MouseLeave:Connect(function()
        tween(b, 0.12, {BackgroundColor3 = C.panel2})
        tween(s, 0.12, {Color = C.line, Transparency = 0.2})
    end)
    return b
end

local function accentBtn(text, parent)
    local b = make("TextButton", {
        BackgroundColor3 = C.acc,
        Text = text,
        Font = gothamBlack,
        TextSize = 13,
        TextColor3 = Color3.new(1, 1, 1),
        AutoButtonColor = false,
        BorderSizePixel = 0,
    }, parent)
    corner(b, 8)
    gradient(b, C.acc, C.acc2, 90)
    b.MouseEnter:Connect(function()
        tween(b, 0.12, {BackgroundColor3 = C.accHi})
    end)
    b.MouseLeave:Connect(function()
        tween(b, 0.12, {BackgroundColor3 = C.acc})
    end)
    return b
end

