-- TOGGLE ROW BUILDER
-- =====================
local function makeToggleRow(text, default, layoutOrder, callback)
    local row = make("Frame", {
        Size = UDim2.new(1, 0, 0, 31),
        BackgroundColor3 = C.panel,
        BorderSizePixel = 0,
        LayoutOrder = layoutOrder,
    }, Content)
    corner(row, 8)
    stroke(row, C.line, 1, 0.3)

    local lbl = label(text, 11, C.sub, gothamBold, Enum.TextXAlignment.Left, row)
    lbl.Size = UDim2.new(1, -56, 1, 0)
    lbl.Position = UDim2.fromOffset(12, 0)

    local track = make("Frame", {
        Size = UDim2.fromOffset(36, 18),
        Position = UDim2.new(1, -44, 0.5, -9),
        BackgroundColor3 = C.line,
        BorderSizePixel = 0,
    }, row)
    corner(track, 9)

    local knob = make("Frame", {
        Size = UDim2.fromOffset(14, 14),
        Position = UDim2.new(0, 2, 0.5, -7),
        BackgroundColor3 = C.txt,
        BorderSizePixel = 0,
    }, track)
    corner(knob, 7)

    local state = default

    local function refresh()
        tween(track, 0.16, {BackgroundColor3 = state and C.acc or C.line})
        tween(knob, 0.16, {Position = UDim2.new(0, state and 20 or 2, 0.5, -7)}, Enum.EasingStyle.Back)
        lbl.TextColor3 = state and C.txt or C.sub
    end

    refresh()

    local clickBtn = make("TextButton", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text = "",
    }, row)

    clickBtn.MouseButton1Click:Connect(function()
        state = not state
        refresh()
        if callback then
            callback(state)
        end
    end)

    local function getState()
        return state
    end

    local function setState(v)
        state = v
        refresh()
    end

    return row, getState, setState
end

