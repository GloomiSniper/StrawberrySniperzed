        doRedeem(currentCode)
    end
end)

-- =====================
-- LISTEN / WORD SNIPER
-- =====================
local function trySnipe(text)
    if not Config.ListenEnabled then
        return
    end
    if not text or text == "" then
        return
    end

    for word in text:gmatch("[%w_]+") do
        if #word >= 3 and (word:match("%u") or word:match("%d")) then
            table.insert(wordBuffer, word)

            if Config.Manual then
                local full = table.concat(wordBuffer)
                CodeInput.Text = full
                currentCode = full
                setStatus(("manual: %d words"):format(#wordBuffer), "wait")
            else
                local needed = Config.WordCount
                local parts = {}
                for i = 1, math.min(#wordBuffer, needed) do
                    parts[i] = wordBuffer[i]
                end
                local built = table.concat(parts)
                CodeInput.Text = built
                currentCode = built

                if #wordBuffer >= needed then
                    wordBuffer = {}
                    setListenState(false)
                    Config.ListenEnabled = false
                    if Config.AutoType then
                        CodeInput.Text = built
                    end
                    if Config.AutoRedeem then
                        doRedeem(built)
                    else
                        setStatus("captured: " .. built, "ok")
                    end
                else
                    setStatus(("listening... %d/%d"):format(#wordBuffer, needed), "wait")
                end
            end
            return
        end
    end
end

-- =====================
-- NOTIFICATION HOOK
-- =====================
local notifyConns = {}

local function hookRemote(remote)
    if not remote then
        return
    end
    local last = ""
    local lastTime = 0
    table.insert(notifyConns, remote.OnClientEvent:Connect(function(msg, ...)
        if type(msg) ~= "string" then
            return
        end
        local clean = msg:gsub("<[^>]->", "")
        if clean == "" then
            return
        end
        local now = os.clock()
        if clean == last and now - lastTime < 0.25 then
            return
        end
        last = clean
        lastTime = now
        trySnipe(clean)
    end))
end

local function setupHooks()
    local net = nil
    pcall(function()
        net = ReplicatedStorage:WaitForChild("Packages", 3)
        if net then
            net = net:FindFirstChild("Net")
        end
    end)

    if net then
        local count = 0
        for _, child in ipairs(net:GetChildren()) do
            if child:IsA("RemoteEvent") or child:IsA("UnreliableRemoteEvent") then
                hookRemote(child)
                count += 1
                if count >= 400 then
                    break
                end
            end
        end
        table.insert(notifyConns, net.ChildAdded:Connect(function(child)
            if child:IsA("RemoteEvent") or child:IsA("UnreliableRemoteEvent") then
                hookRemote(child)
            end
        end))
        statusIndicator.BackgroundColor3 = C.ok
        setStatus("ready - hooks active", "ok")
    else
        statusIndicator.BackgroundColor3 = C.warn
        setStatus("ready - no net found", "warn")
    end
end

task.spawn(setupHooks)

