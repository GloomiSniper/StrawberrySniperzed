-- =====================
local function applyCase(code)
    if Config.CaseMode == "UPPER" then
        return code:upper()
    elseif Config.CaseMode == "lower" then
        return code:lower()
    else
        return code
    end
end

local function findCodeBox()
    local codes = playerGui:FindFirstChild("Codes")
    if not codes then
        return nil
    end
    local main = (codes:FindFirstChild("Codes") or codes):FindFirstChild("Main")
    local tb = main and main:FindFirstChild("TextBox")
    if tb and tb:IsA("TextBox") then
        return tb
    end
    for _, d in ipairs(codes:GetDescendants()) do
        if d:IsA("TextBox") then
            return d
        end
    end
    return nil
end

local function findConfirmBtn()
    local codes = playerGui:FindFirstChild("Codes")
    if not codes then
        return nil
    end
    local c2 = codes:FindFirstChild("Codes") or codes
    local confirm = (c2:FindFirstChild("Main") or c2):FindFirstChild("Confirm")
    if confirm and (confirm:IsA("TextButton") or confirm:IsA("ImageButton")) then
        return confirm
    end
    for _, d in ipairs(codes:GetDescendants()) do
        if d:IsA("TextButton") or d:IsA("ImageButton") then
            local n = d.Name:lower()
            if n:find("confirm") or n:find("submit") or n:find("redeem") or n:find("enter") then
                return d
            end
        end
    end
    return nil
end

local getconnections_ = getconnections or (debug and rawget(debug, "getconnections"))

local function fireConnections(signal, ...)
    if not getconnections_ then
        return false
    end
    local ok, conns = pcall(getconnections_, signal)
    if not ok or type(conns) ~= "table" or #conns == 0 then
        return false
    end
    local fired = false
    local args = table.pack(...)
    for _, c in ipairs(conns) do
        if c.Enabled ~= false then
            local fn = nil
            pcall(function()
                fn = c.Function
            end)
            if fn then
                pcall(task.spawn, fn, table.unpack(args, 1, args.n))
                fired = true
            else
                pcall(function()
                    c:Fire(table.unpack(args, 1, args.n))
                end)
                fired = true
            end
        end
    end
    return fired
end

local function redeemViaUI(code)
    if not getconnections_ then
        return false
    end
    local tb = findCodeBox()
    if not tb then
        return false
    end
    pcall(function()
        tb.Text = code
        tb.Active = true
        tb.Selectable = true
    end)
    local confirm = findConfirmBtn()
    local fired = false
    if confirm then
        fired = fireConnections(confirm.MouseButton1Click)
        fired = fireConnections(confirm.Activated) or fired
    end
    if not fired then
        fired = fireConnections(tb.FocusLost, true)
    end
    return fired
end

local function redeemViaFocus(code)
    local tb = findCodeBox()
    if not tb then
        return false
    end
    local ok = pcall(function()
        tb.Text = code
        tb:CaptureFocus()
    end)
    if not ok then
        return false
    end
    task.wait(0.1)
    local ok2 = pcall(function()
        tb:ReleaseFocus(true)
    end)
    return ok2
end

local function redeemViaRemote(code)
    local rs = game:GetService("ReplicatedStorage")
    local names = {
        "RedeemCode", "Redeem", "CodeRedeem",
        "PromoCodes", "EnterCode", "ClaimCode", "UseCode",
    }
    for _, n in ipairs(names) do
        local r = rs:FindFirstChild(n, true)
        if r then
            if r:IsA("RemoteEvent") then
                r:FireServer(code)
                return true
            elseif r:IsA("RemoteFunction") then
                pcall(function()
                    r:InvokeServer(code)
                end)
                return true
            end
        end
    end
    return false
end

local function doRedeem(rawCode)
    if rawCode == "" then
        setStatus("no code entered", "err")
        return false
    end
    local code = applyCase(rawCode)
    setStatus("redeeming: " .. code, "busy")

    local ok = redeemViaUI(code)
    if not ok then
        ok = redeemViaFocus(code)
    end
    if not ok then
        ok = redeemViaRemote(code)
    end

    if ok then
        setStatus("sent: " .. code, "ok")
        showRedeemed(code)
    else
        setStatus("failed: " .. code, "err")
    end
    return ok
end

