local function makeOptionRow(text, options, default, layoutOrder, callback)
    local row = make("Frame", {
        Size = UDim2.new(1, 0, 0, 31),
        BackgroundColor3 = C.panel,
        BorderSizePixel = 0,
        LayoutOrder = layoutOrder,
    }, Content)
    corner(row, 8)
    stroke(row, C.line, 1, 0.3)

    local lbl = label(text, 11, C.sub, gothamBold, Enum.TextXAlignment.Left, row)
    lbl.Size = UDim2.fromOffset(60, 31)
    lbl.Position = UDim2.fromOffset(11, 0)

    local optFrame = make("Frame", {
        Size = UDim2.fromOffset(#options * 46, 23),
        Position = UDim2.new(1, -(#options * 46 + 8), 0.5, -11.5),
        BackgroundColor3 = C.input,
        BorderSizePixel = 0,
    }, row)
    corner(optFrame, 7)

    local btns = {}
    local selected = default

    local function selectOpt(opt)
        selected = opt
        for k, b in pairs(btns) do
            tween(b, 0.12, {BackgroundColor3 = k == opt and C.acc or C.input})
            b.TextColor3 = k == opt and Color3.new(1, 1, 1) or C.sub
        end
        if callback then
            callback(opt)
        end
    end

    for i, opt in ipairs(options) do
        local b = make("TextButton", {
            Size = UDim2.new(1 / #options, -2, 1, -2),
            Position = UDim2.new((i - 1) / #options, 1, 0, 1),
            BackgroundColor3 = C.input,
            Text = opt,
            Font = gothamBold,
            TextSize = 10,
            TextColor3 = C.sub,
            AutoButtonColor = false,
            BorderSizePixel = 0,
        }, optFrame)
        corner(b, 6)
        btns[opt] = b
        b.MouseButton1Click:Connect(function()
            selectOpt(opt)
        end)
    end

    selectOpt(default)
    return row
end

