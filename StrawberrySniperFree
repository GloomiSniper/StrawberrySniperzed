local function setSpam(active)
    Config.SpamActive = active
    spamBtn.Text = active and "STOP" or "START"
    spamBtn.TextColor3 = active and C.acc or C.txt
    tween(spamDot, 0.16, {BackgroundColor3 = active and C.acc or C.line})
    tween(spamLbl, 0.16, {TextColor3 = active and C.txt or C.sub})
    tween(spamStroke, 0.16, {
        Color = active and C.acc or C.line,
        Transparency = active and 0.15 or 0.3,
    })
    if active then
        spamThread = task.spawn(function()
            local count = 0
            while Config.SpamActive do
                count += 1
                if currentCode ~= "" then
                    doRedeem(currentCode)
                    setStatus(("spam %d - %s"):format(count, currentCode), "busy")
                else
                    setStatus("spam - waiting for code...", "wait")
                end
                task.wait(0.5)
            end
        end)
    else
        spamThread = nil
        setStatus("spam stopped", "wait")
    end
end

